rules_version = '2';
// صلاحيات قاعدة البيانات
// - صاحب الموقع (أول حساب يسجل) ومن دوره admin: صلاحية كاملة
// - مدير المركز (manager): اطلاع على كل شيء + تعديل الرواتب وحقولها
// لا يوجد تسجيل ذاتي: المسؤول يضيف الحسابات من الإعدادات.
// صاحب الموقع = أول حساب يُنشأ من "إعداد أول مرة" (يُحفظ في meta/owner ولا يمكن تغييره من الموقع).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function ownerDoc() { return /databases/$(database)/documents/meta/owner; }
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.email == myEmail(); }
    function userDoc() { return /databases/$(database)/documents/users/$(myEmail()); }
    function role() { return exists(userDoc()) ? get(userDoc()).data.role : 'none'; }
    function isAdmin() { return isOwner() || (signedIn() && role() == 'admin'); }
    function isManager() { return signedIn() && role() == 'manager'; }
    function isMember() { return isAdmin() || isManager(); }

    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.email == myEmail();
      allow update, delete: if false;
    }
    match /meta/public {
      allow read: if true;
      allow write: if isOwner();
    }
    match /users/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow write: if isAdmin();
    }
    match /salaries/{id} { allow read, write: if isMember(); }
    match /salaryFields/{id} { allow read, write: if isMember(); }
    match /materials/{id} { allow read: if isMember(); allow write: if isAdmin(); }
    match /staff/{id} { allow read: if isMember(); allow write: if isAdmin(); }
    match /inventory/{id} { allow read: if isMember(); allow write: if isAdmin(); }
    match /stats/{id} { allow read: if isMember(); allow write: if isAdmin(); }
    match /purchases/{id} { allow read: if isMember(); allow write: if isAdmin(); }
    match /counts/{id} { allow read: if isMember(); allow write: if isAdmin(); }
  }
}
